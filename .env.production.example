# Copiar a .env.production antes del build.
# La API y el frontend pueden estar en dominios distintos.
VITE_API_BASE_URL=https://api.example.com/api
VITE_MEDIA_BASE_URL=https://api.example.com

# Dominio público exacto del frontend, sin barra final.
VITE_SITE_URL=https://www.example.com

# Verificación de buscadores (opcional).
VITE_GOOGLE_SITE_VERIFICATION=
VITE_BING_SITE_VERIFICATION=

# Analítica y publicidad. Sin ID no se carga ningún script.
VITE_GA_MEASUREMENT_ID=
VITE_GTM_ID=
VITE_META_PIXEL_ID=

# Datos para páginas legales.
VITE_BUSINESS_NAME=Zona Lab
VITE_CONTACT_EMAIL=zonasportoficial@gmail.com
VITE_LEGAL_UPDATED_AT=12 de noviembre de 2026

# Solo para build:seo. Debe apuntar a la API pública.
SEO_API_BASE_URL=https://api.example.com/api
