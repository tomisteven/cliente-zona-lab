# Visible en el bundle del cliente. No incluir secretos.
# Desarrollo local: Vite redirige /api y /uploads al backend.
VITE_API_BASE_URL=/api

# Opcional. Si la API está en otro dominio, indicá su origen para resolver
# las imágenes servidas en /uploads/media. Ej.: https://api.example.com
VITE_MEDIA_BASE_URL=

# Solo para el proxy del servidor de desarrollo. No se expone al cliente.
DEV_API_TARGET=http://localhost:5050
