# Visible en el bundle del cliente. No incluir secretos.
# Desarrollo local: Vite redirige /api y /uploads al backend.
VITE_API_BASE_URL=/api

# Opcional. Si la API está en otro dominio, indicá su origen para resolver
# las imágenes servidas en /uploads/media. Ej.: https://api.example.com
VITE_MEDIA_BASE_URL=

# Dominio público del sitio. Se usa para canonical, Open Graph y sitemap.
VITE_SITE_URL=http://localhost:8080

# Códigos de verificación de Search Console (opcionales).
VITE_GOOGLE_SITE_VERIFICATION=
VITE_BING_SITE_VERIFICATION=

# Analítica y publicidad. Sin ID no se carga ningún script.
VITE_GA_MEASUREMENT_ID=
VITE_GTM_ID=
VITE_META_PIXEL_ID=

# Datos para páginas legales.
VITE_BUSINESS_NAME=Zona Lab
VITE_CONTACT_EMAIL=zonasportoficial@gmail.com
VITE_LEGAL_UPDATED_AT=12 de noviembre de 2026

# Solo para el proxy del servidor de desarrollo. No se expone al cliente.
DEV_API_TARGET=http://localhost:5050

# Solo para generar el sitemap/prerender durante el build. No se expone al cliente.
SEO_API_BASE_URL=http://localhost:5050/api
